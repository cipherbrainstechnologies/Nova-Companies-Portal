# Local development (docker compose postgres / redis / minio)
DATABASE_URL="postgresql://nova:nova@localhost:5432/nova_portal?schema=public"
DIRECT_URL="postgresql://nova:nova@localhost:5432/nova_portal?schema=public"
REDIS_URL="redis://localhost:6379"
AUTH_SECRET="replace-with-32-plus-char-random-secret"
APP_URL="http://localhost:3000"

# Object storage — local MinIO. On Railway these are wired from the payslip-files bucket.
S3_ENDPOINT="http://localhost:9000"
S3_REGION="us-east-1"
S3_BUCKET="nova-portal"
S3_ACCESS_KEY_ID="minioadmin"
S3_SECRET_ACCESS_KEY="minioadmin"
S3_FORCE_PATH_STYLE="true"

EMAIL_PROVIDER="resend"
EMAIL_API_KEY=""
EMAIL_FROM="Nova Portal <noreply@example.com>"
PDF_SIGNING_PRIVATE_KEY=""
PDF_SIGNING_CERTIFICATE=""
OTP_PEPPER="replace-with-otp-pepper"
SEED_DEV="0"
MATCH_AUTO_SELECT_THRESHOLD="85"

# Railway production: do not commit secrets. Prefer `railway config apply` from .railway/railway.ts
# then set AUTH_SECRET, OTP_PEPPER, APP_URL (and EMAIL_* when leaving console provider).
