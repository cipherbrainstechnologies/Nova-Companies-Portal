{
  "$schema": "https://design-tokens.github.io/community-group/format/",
  "meta": {
    "name": "Nova Workforce Marketing",
    "version": "1.0.0",
    "scope": "public-site-only",
    "extends": ["--nova-ink", "--nova-teal"]
  },
  "color": {
    "navy": { "value": "#17233B", "alias": "--nova-ink" },
    "accent": { "value": "#6254D9", "alias": "--nova-teal" },
    "accentSoft": { "value": "#F1EFFF", "alias": "--nova-teal-soft" },
    "canvas": { "value": "#F8F9FC", "alias": "--mkt-canvas" },
    "surface": { "value": "#FFFFFF", "alias": "--mkt-surface" },
    "mutedText": { "value": "#657187" },
    "border": { "value": "#E6E8F0", "alias": "--mkt-border" },
    "accentHover": { "value": "#5248C4", "alias": "--mkt-accent-hover" }
  },
  "radius": {
    "control": { "value": "10px" },
    "card": { "value": "16px", "alias": "--mkt-radius" },
    "panel": { "value": "20px", "alias": "--mkt-radius-lg" }
  },
  "shadow": {
    "elevated": {
      "value": "0 8px 30px rgb(23 35 59 / 0.08)",
      "alias": "--mkt-shadow"
    }
  },
  "typography": {
    "hero": {
      "desktop": { "min": "52px", "max": "68px" },
      "mobile": { "min": "34px", "max": "42px" }
    },
    "sectionTitle": { "min": "28px", "max": "40px" },
    "body": { "min": "16px", "max": "18px" }
  },
  "layout": {
    "contentMaxWidth": { "value": "1152px", "alias": "--mkt-container-max" }
  }
}
