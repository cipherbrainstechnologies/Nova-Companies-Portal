  createdAt            DateTime @default(now())

  clientOrganization   ClientOrganization @relation(fields: [clientOrganizationId], references: [id], onDelete: Cascade)
  employee             Employee           @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  novaCompany          Company            @relation(fields: [novaCompanyId], references: [id])

  @@unique([clientOrganizationId, employeeId, periodYear, periodMonth])
