  @@unique([clientOrganizationId, periodYear, periodMonth])
}

model PayrollFundingRequest {
  id                   String   @id @default(cuid())
  clientOrganizationId String
  periodYear           Int
  periodMonth          Int
  amount               Decimal  @db.Decimal(18, 2)
  currency             String
  status               String   @default("REQUESTED")
