model SecurityEvent {
  id        String   @id @default(cuid())
  userId    String?
  eventType String
  metadataJson Json?
  createdAt DateTime @default(now())

  @@index([eventType, createdAt])
}

enum PublicQuoteRequestStatus {
  SUBMITTED
  ACKNOWLEDGED
  CLOSED
}

model PublicPricingPlan {
