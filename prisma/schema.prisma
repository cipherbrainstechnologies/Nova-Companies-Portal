  @@unique([employeeId, checkType])
}

model EmployeeChangeRequest {
  id                   String   @id @default(cuid())
  employeeId           String
  clientOrganizationId String
  changeType           String
  effectiveDate        DateTime
  payloadJson          Json
  status               String   @default("SUBMITTED")
  createdAt            DateTime @default(now())

  employee             Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@index([clientOrganizationId])
}

model ClientPricingAgreement {
  id                   String             @id @default(cuid())
  clientOrganizationId String
  version              Int
  currency             String
  feePerEmployee       Decimal            @db.Decimal(18, 2)
  setupFee             Decimal?           @db.Decimal(18, 2)
  termsJson            Json?
  approvedByUserId     String?
  effectiveFrom        DateTime
  effectiveTo          DateTime?
  createdAt            DateTime           @default(now())

  clientOrganization   ClientOrganization @relation(fields: [clientOrganizationId], references: [id], onDelete: Cascade)
