model ClientInvoice {
  id                   String                      @id @default(cuid())
  clientOrganizationId String
  novaCompanyId        String
  invoiceNumber        String
  periodYear           Int
  periodMonth          Int
  currency             String
  financialState       ClientInvoiceFinancialState @default(INVOICE_DRAFT)
  subtotal             Decimal                     @db.Decimal(18, 2)
  taxTotal             Decimal                     @db.Decimal(18, 2)
  total                Decimal                     @db.Decimal(18, 2)
  issuedAt             DateTime?
  dueAt                DateTime?
  pdfSha256            String?
  pdfStorageKey        String?
  snapshotJson         Json?
  createdAt            DateTime                    @default(now())
  updatedAt            DateTime                    @updatedAt

  clientOrganization   ClientOrganization          @relation(fields: [clientOrganizationId], references: [id], onDelete: Cascade)
