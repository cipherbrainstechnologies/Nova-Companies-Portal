model HireRequest {
  id                   String            @id @default(cuid())
  clientOrganizationId String
  status               HireRequestStatus @default(DRAFT)
  candidateJson        Json
  provisionalCostJson  Json?
  submittedAt          DateTime?
  employeeId           String?
  createdAt            DateTime          @default(now())
  updatedAt            DateTime          @updatedAt

  clientOrganization   ClientOrganization @relation(fields: [clientOrganizationId], references: [id], onDelete: Cascade)
  employee             Employee?          @relation(fields: [employeeId], references: [id])

  @@index([clientOrganizationId, status])
}

model EmployeeVerificationCheck {
