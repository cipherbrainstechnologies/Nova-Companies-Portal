  employee          Employee?              @relation(fields: [employeeId], references: [id])

  @@index([employeeId])
}

model EmployerCostSnapshot {
  id                   String   @id @default(cuid())
  clientOrganizationId String
  employeeId           String
  novaCompanyId        String
  periodYear           Int
  periodMonth          Int
