generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum GlobalRole {
  SUPER_ADMIN
  OPERATIONS_MANAGER
  EMPLOYEE
  CLIENT_USER
}

enum EmployeeStatus {
  ACTIVE
  CONTACT_DETAILS_REQUIRED
  BLOCKED
  EXITED
}

enum EmployeeDocumentFolder {
  OFFER_AND_CONTRACT
  KYC_AND_DOCUMENTS
  SALARY_SLIPS
}

enum EmployeeImportBatchStatus {
  PENDING
  PREVIEWED
  COMMITTED
  FAILED
}

enum EmployeeImportRowStatus {
  PENDING
  CREATED
  UPDATED
  SKIPPED
  ERROR
}

enum AppModule {
  dashboard
  companies
  employees
  salaryStructure
  templates
  statements
  payroll
  payslips
  finance
  tds
  reports
  users
  audit
  clients
}

enum AppAction {
  view
  create
  edit
  approve
  issue
  download
  manage
  reconcile
  resendEmail
  upload
  submit
  invite
  execute
}

enum ReconciliationStatus {
  UNMATCHED
  MATCHED_EXACT
  PARTIAL_PAYMENT_REVIEW_REQUIRED
  AMOUNT_MISMATCH_REVIEW_REQUIRED
  SALARY_STRUCTURE_INCOMPLETE
  MANUALLY_MAPPED
  NON_PAYROLL
  IGNORED
  APPROVED_FOR_ISSUE
  ISSUED
  EMAIL_SENT
  EMAIL_FAILED
}

enum EmailDeliveryStatus {
  QUEUED
  SENT
  DELIVERED
  FAILED
  BOUNCED
}

enum EmailDeliveryPreference {
  OFFICIAL_PREFERRED
  PERSONAL_PREFERRED
  BOTH
}

enum VarianceClassification {
  OVERTIME
  BONUS
  REIMBURSEMENT
  ADJUSTMENT
  ARREARS
  DUPLICATE_PAYMENT
  UNPAID_LEAVE
  LOAN_DEDUCTION
  CASH_COMPONENT
  OTHER
}

enum PayrollRunStatus {
  DRAFT
  PARSING
  RECONCILIATION_REQUIRED
  READY_FOR_REVIEW
  APPROVED
  ISSUING
  ISSUED
  FAILED
  CANCELLED
  SUPERSEDED
}

enum AttendanceBasis {
  CALENDAR_DAY
  FIXED_30
  WORKING_DAY
}

enum PayslipStatus {
  DRAFT
  APPROVED
  ISSUING
  ISSUED
  SUPERSEDED
  CANCELLED
}

enum StatementStatus {
  UPLOADED
  PARSING
  PARSED
  FAILED
}

enum TransactionClassification {
  SALARY
  OVERTIME
  REIMBURSEMENT
  TAX
  EXPENSE
  LOAN_EMI
  OWNER_TRANSFER
  CREDIT_CARD
  CASH_WITHDRAWAL
  REVENUE
  PF_ESI
  CONTRACTOR
  IGNORE
  UNCLASSIFIED
}

enum MatchSuggestionStatus {
  SUGGESTED
  ACCEPTED
  REJECTED
  NEEDS_REVIEW
  AUTO_SELECTED
}

enum TaxRegime {
  OLD
  NEW
}

enum DeclarationStatus {
  DRAFT
  SUBMITTED
  APPROVED
  REJECTED
}

enum ProfitTreatment {
  BUSINESS_EXPENSE
  FINANCING_OR_PERSONAL
  OWNER_EXCLUDED
  REVENUE
  IGNORE
}

model User {
  id                   String    @id @default(cuid())
  phone                String    @unique
  email                String?   @unique
  displayName          String?
  passwordHash         String
  globalRole           GlobalRole
  mustChangePassword   Boolean   @default(true)
  failedLoginAttempts  Int       @default(0)
  lockedUntil          DateTime?
  isActive             Boolean   @default(true)
  employeeId           String?   @unique
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  employee             Employee? @relation(fields: [employeeId], references: [id])
  sessions             Session[]
  passwordResetOtps    PasswordResetOtp[]
  permissionGrants     PermissionGrant[]
  auditLogs            AuditLog[] @relation("AuditActor")
  clientMemberships    ClientMembership[]
  clientInvitationsSent ClientInvitation[] @relation("ClientInvitationInviter")
  clientActivityAudits ClientActivityAudit[]
}

model Session {
  id               String   @id @default(cuid())
  userId           String
  tokenHash        String   @unique
  expiresAt        DateTime
  revokedAt        DateTime?
  ipAddress        String?
  userAgent        String?
  activeClientOrganizationId String?
  createdAt        DateTime @default(now())

  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  activeClientOrganization ClientOrganization? @relation(fields: [activeClientOrganizationId], references: [id])

  @@index([userId])
  @@index([expiresAt])
}

model PasswordResetOtp {
  id          String    @id @default(cuid())
  userId      String
  emailTarget String
  codeHash    String
  expiresAt   DateTime
  usedAt      DateTime?
  createdAt   DateTime  @default(now())

  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
}

model PermissionGrant {
  id        String    @id @default(cuid())
  userId    String
  companyId String
  module    AppModule
  action    AppAction
  createdAt DateTime  @default(now())

  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  company   Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@unique([userId, companyId, module, action])
  @@index([companyId])
}

model Company {
  id          String   @id @default(cuid())
  name        String
  prefix      String   @unique
  gstin       String?
  address     String?
  email       String?
  phone       String?
  logoKey     String?
  isActive    Boolean  @default(true)
  autoIssueExactMatches Boolean @default(false)
  /** Company default professional tax (₹/month). Employee salary structures may override. */
  defaultMonthlyProfessionalTax Decimal @default(200) @db.Decimal(18, 2)
  /** Attendance / proration denominator policy for salary slips. */
  attendanceBasis AttendanceBasis @default(CALENDAR_DAY)
  /** Payment match window around expected pay date (1st of month after salary month). */
  paymentSearchDaysBefore Int @default(10)
  paymentSearchDaysAfter Int @default(14)
  emailDeliveryPreference EmailDeliveryPreference @default(OFFICIAL_PREFERRED)
  matchScoreThreshold Int @default(50)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  sequence            CompanySequence?
  templates           CompanyTemplate[]
  employees           Employee[]
  permissionGrants    PermissionGrant[]
  bankStatements      BankStatement[]
  payrollRuns         PayrollRun[]
  payslips            Payslip[]
  financialCategories FinancialCategory[]
  financialTransactions FinancialTransaction[]
  profitSnapshots     ProfitReportSnapshot[]
  taxConfigs          TaxFinancialYearConfig[]
  profitPolicies      ProfitPolicyRule[]
  salaryComponents    SalaryComponent[]
  employeeImportBatches EmployeeImportBatch[]
  employeeImportRows  EmployeeImportRow[] @relation("EmployeeImportRowCompany")
  novaEntityClientAgreements NovaEntityClientAgreement[]
  employmentAssignments EmploymentAssignment[]
  employerCostSnapshots EmployerCostSnapshot[]
  clientInvoicesAsSeller ClientInvoice[]
  clientOrganizationsProposed ClientOrganization[] @relation("ClientProposedNova")
}

model CompanySequence {
  id           String @id @default(cuid())
  companyId    String @unique
  nextNumber   Int    @default(1)
  company      Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
}

model CompanyTemplate {
  id          String   @id @default(cuid())
  companyId   String
  name        String
  version     Int
  htmlBody    String
  cssBody     String
  sourceDocKey String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())

  company     Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  payslipVersions PayslipVersion[]

  @@unique([companyId, version])
}

model Employee {
  id              String         @id @default(cuid())
  companyId       String
  employeeCode    String
  firstName       String
  lastName        String
  displayName     String?
  designation     String?
  department      String?
  location        String?
  dateOfJoining   DateTime?
  /** Last employed date when known; used for mid-month exit proration. */
  dateOfExit      DateTime?
  status          EmployeeStatus @default(ACTIVE)
  pan             String?
  pfNumber        String?
  uan             String?
  esiNumber       String?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  company         Company        @relation(fields: [companyId], references: [id], onDelete: Cascade)
  user            User?
  contact         EmployeeContact?
  bankAccount     EmployeeBankAccount?
  salaryStructure EmployeeSalaryStructure?
  salaryStructureVersions EmployeeSalaryStructureVersion[]
  paymentAliases  EmployeePaymentAlias[]
  payrollLines    PayrollEmployeeLine[]
  payslips        Payslip[]
  taxDeclarations EmployeeTaxDeclaration[]
  tdsProjections  TdsProjection[]
  matchSuggestions StatementMatchSuggestion[]
  priorMappings   EmployeeNarrationMapping[]
  reconciledTxns  StatementTransaction[] @relation("MatchedEmployee")
  importRows      EmployeeImportRow[]
  documents       EmployeeDocument[]
  employmentAssignments EmploymentAssignment[]
  hireRequests    HireRequest[]
  verificationChecks EmployeeVerificationCheck[]
  changeRequests  EmployeeChangeRequest[]
  feeSchedules    EmployeeFeeSchedule[]
  costSnapshots   EmployerCostSnapshot[]
  clientInvoiceLines ClientInvoiceLine[]
  clientEmployeeScopes ClientEmployeeScope[]

  @@unique([companyId, employeeCode])
  @@index([companyId, status])
}

model EmployeeContact {
  id             String  @id @default(cuid())
  employeeId     String  @unique
  personalEmail  String?
  officialEmail  String?
  primaryPhone   String?
  alternatePhone String?

  employee       Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
}

model EmployeeImportBatch {
  id           String                    @id @default(cuid())
  companyId    String?
  actorUserId  String
  fileName     String
  status       EmployeeImportBatchStatus @default(PENDING)
  rowCount     Int                       @default(0)
  createdCount Int                       @default(0)
  updatedCount Int                       @default(0)
  skippedCount Int                       @default(0)
  errorCount   Int                       @default(0)
  effectiveFrom DateTime?
  summaryJson  Json?
  createdAt    DateTime                  @default(now())
  updatedAt    DateTime                  @updatedAt

  company      Company?                  @relation(fields: [companyId], references: [id], onDelete: SetNull)
  rows         EmployeeImportRow[]

  @@index([companyId, createdAt])
  @@index([actorUserId, createdAt])
}

model EmployeeImportRow {
  id                 String                  @id @default(cuid())
  batchId            String
  rowNumber          Int
  rawJson            Json
  status             EmployeeImportRowStatus @default(PENDING)
  employeeId         String?
  /** Company resolved at preview; confirm must reuse the same ID. */
  resolvedCompanyId  String?
  parsedJson         Json?
  errorsJson         Json?
  warningsJson       Json?
  createdAt          DateTime                @default(now())

  batch              EmployeeImportBatch     @relation(fields: [batchId], references: [id], onDelete: Cascade)
  employee           Employee?               @relation(fields: [employeeId], references: [id], onDelete: SetNull)
  resolvedCompany    Company?                @relation("EmployeeImportRowCompany", fields: [resolvedCompanyId], references: [id], onDelete: SetNull)

  @@unique([batchId, rowNumber])
  @@index([employeeId])
  @@index([resolvedCompanyId])
}

model EmployeeBankAccount {
  id            String  @id @default(cuid())
  employeeId    String  @unique
  bankName      String?
  accountNumber String?
  ifsc          String?
  accountLast4  String?
  accountHolderName String?

  employee      Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
}

model EmployeePaymentAlias {
  id               String   @id @default(cuid())
  employeeId       String
  alias            String
  normalizedAlias  String
  createdAt        DateTime @default(now())

  employee         Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@unique([employeeId, normalizedAlias])
  @@index([employeeId])
}

model SalaryComponent {
  id          String  @id @default(cuid())
  companyId   String
  code        String
  name        String
  kind        String
  isEarning   Boolean
  sortOrder   Int     @default(0)

  company     Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@unique([companyId, code])
}

model EmployeeSalaryStructure {
  id                 String   @id @default(cuid())
  employeeId         String   @unique
  version            Int      @default(1)
  annualCtc          Decimal? @db.Decimal(18, 2)
  monthlyGross       Decimal? @db.Decimal(18, 2)
  monthlyTds         Decimal? @db.Decimal(18, 2)
  monthlyPt          Decimal? @db.Decimal(18, 2)
  expectedMonthlyNet Decimal? @db.Decimal(18, 2)
  effectiveFrom      DateTime @default(now())
  componentsJson     Json
  notes              String?
  updatedAt          DateTime @updatedAt

  employee           Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
}

model EmployeeSalaryStructureVersion {
  id                 String   @id @default(cuid())
  employeeId         String
  version            Int
  annualCtc          Decimal? @db.Decimal(18, 2)
  monthlyGross       Decimal? @db.Decimal(18, 2)
  monthlyTds         Decimal? @db.Decimal(18, 2)
  monthlyPt          Decimal? @db.Decimal(18, 2)
  expectedMonthlyNet Decimal? @db.Decimal(18, 2)
  effectiveFrom      DateTime
  effectiveTo        DateTime?
  componentsJson     Json
  notes              String?
  createdAt          DateTime @default(now())
  createdById        String?

  employee           Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@unique([employeeId, version])
  @@index([employeeId, effectiveFrom])
}

model DocumentFile {
  id           String   @id @default(cuid())
  storageKey   String   @unique
  bucket       String
  mimeType     String
  sizeBytes    Int
  checksumSha256 String
  originalName String
  createdAt    DateTime @default(now())

  bankStatements BankStatement[]
  payslipVersions PayslipVersion[] @relation("PdfFile")
  calculationSnapshots PayslipVersion[] @relation("CalcSnapshot")
  employeeDocuments EmployeeDocument[]
}

model EmployeeDocument {
  id           String                 @id @default(cuid())
  employeeId   String
  folder       EmployeeDocumentFolder
  title        String?
  fileId       String
  uploadedById String?
  createdAt    DateTime               @default(now())
  updatedAt    DateTime               @updatedAt

  employee     Employee               @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  file         DocumentFile           @relation(fields: [fileId], references: [id], onDelete: Restrict)

  @@index([employeeId, folder, createdAt])
}

model BankStatement {
  id           String          @id @default(cuid())
  companyId    String
  bankCode     String
  accountHint  String?
  accountNumber String?
  salaryYear   Int?
  salaryMonth  Int?
  periodStart  DateTime?
  periodEnd    DateTime?
  openingBalance Decimal? @db.Decimal(18, 2)
  statementClosingBalance Decimal? @db.Decimal(18, 2)
  calculatedClosingBalance Decimal? @db.Decimal(18, 2)
  reconciliationDifference Decimal? @db.Decimal(18, 2)
  totalCredits Decimal? @db.Decimal(18, 2)
  totalDebits Decimal? @db.Decimal(18, 2)
  transactionCount Int?
  parserVersion String?
  statementReconciled Boolean @default(false)
  status       StatementStatus @default(UPLOADED)
  fileId       String
  checksumSha256 String
  parseError   String?
  uploadedById String?
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt

  company      Company         @relation(fields: [companyId], references: [id], onDelete: Cascade)
  file         DocumentFile    @relation(fields: [fileId], references: [id])
  transactions StatementTransaction[]
  payrollRuns  PayrollRun[]

  @@unique([companyId, checksumSha256])
  @@index([companyId, status])
}

model StatementTransaction {
  id              String   @id @default(cuid())
  statementId     String
  txnDate         DateTime
  valueDate       DateTime?
  particulars     String
  debit           Decimal? @db.Decimal(18, 2)
  credit          Decimal? @db.Decimal(18, 2)
  balance         Decimal? @db.Decimal(18, 2)
  chequeNumber    String?
  branch          String?
  utrReference    String?
  rowIndex        Int
  /** Calendar salary month derived from value/txn date (supports multi-month statements). */
  salaryYear      Int?
  salaryMonth     Int?
  /** Company-scoped dedup key; duplicates from overlapping statements are marked ignored. */
  fingerprint     String?
  isDuplicate     Boolean  @default(false)
  classification  TransactionClassification @default(UNCLASSIFIED)
  reconciliationStatus ReconciliationStatus @default(UNMATCHED)
  matchedEmployeeId String?
  expectedAmount  Decimal? @db.Decimal(18, 2)
  actualAmount    Decimal? @db.Decimal(18, 2)
  varianceAmount  Decimal? @db.Decimal(18, 2)
  matchScore      Int?
  matchExplanation String?
  varianceClassification VarianceClassification?
  reviewReason    String?
  reviewedById    String?
  reviewedAt      DateTime?
  ignoreReason    String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  statement       BankStatement @relation(fields: [statementId], references: [id], onDelete: Cascade)
  matchedEmployee Employee? @relation("MatchedEmployee", fields: [matchedEmployeeId], references: [id])
  matchSuggestions StatementMatchSuggestion[]
  classifications StatementClassification[]
  payrollLinks    PayrollEmployeeLine[] @relation("PrimaryTxn")

  @@index([statementId, txnDate])
  @@index([reconciliationStatus])
  @@index([matchedEmployeeId])
  @@index([fingerprint])
  @@index([salaryYear, salaryMonth])
}

model StatementClassification {
  id            String                    @id @default(cuid())
  transactionId String
  classification TransactionClassification
  classifiedById String?
  notes         String?
  createdAt     DateTime                  @default(now())

  transaction   StatementTransaction      @relation(fields: [transactionId], references: [id], onDelete: Cascade)
}

model StatementMatchSuggestion {
  id            String                @id @default(cuid())
  transactionId String
  employeeId    String
  score         Int
  breakdownJson Json
  status        MatchSuggestionStatus @default(SUGGESTED)
  createdAt     DateTime              @default(now())

  transaction   StatementTransaction  @relation(fields: [transactionId], references: [id], onDelete: Cascade)
  employee      Employee              @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@index([transactionId, score])
}

model EmployeeNarrationMapping {
  id             String   @id @default(cuid())
  employeeId     String
  normalizedName String
  createdAt      DateTime @default(now())

  employee       Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@unique([employeeId, normalizedName])
}

model PayrollRun {
  id          String           @id @default(cuid())
  companyId   String
  year        Int
  month       Int
  status      PayrollRunStatus @default(DRAFT)
  statementId String?
  createdById String?
  approvedAt  DateTime?
  issuedAt    DateTime?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  company     Company          @relation(fields: [companyId], references: [id], onDelete: Cascade)
  statement   BankStatement?   @relation(fields: [statementId], references: [id])
  lines       PayrollEmployeeLine[]
  payslips    Payslip[]

  @@unique([companyId, year, month])
  @@index([companyId, status])
}

model PayrollEmployeeLine {
  id                String   @id @default(cuid())
  payrollRunId      String
  employeeId        String
  primaryTxnId      String?
  status            PayslipStatus @default(DRAFT)
  paymentStatus     ReconciliationStatus @default(UNMATCHED)
  expectedAmount    Decimal? @db.Decimal(18, 2)
  actualAmount      Decimal? @db.Decimal(18, 2)
  varianceAmount    Decimal? @db.Decimal(18, 2)
  paymentReference  String?
  varianceClassification VarianceClassification?
  approvalReason    String?
  approvedById      String?
  calculationSnapshotJson Json?
  workingDays       Decimal? @db.Decimal(8, 2)
  weeklyOffs        Decimal? @db.Decimal(8, 2)
  paidHolidays      Decimal? @db.Decimal(8, 2)
  presentDays       Decimal? @db.Decimal(8, 2)
  casualLeave       Decimal? @db.Decimal(8, 2)
  privilegedLeave   Decimal? @db.Decimal(8, 2)
  sickLeave         Decimal? @db.Decimal(8, 2)
  leaveWithoutPay   Decimal? @db.Decimal(8, 2)
  /** Reviewer confirmed assumed/computed attendance for this line. */
  attendanceConfirmed Boolean @default(false)
  attendanceAssumption String?
  expectedPaymentDate DateTime?
  cashComponent     Decimal? @db.Decimal(18, 2)
  grossEarnings     Decimal  @default(0) @db.Decimal(18, 2)
  grossDeductions   Decimal  @default(0) @db.Decimal(18, 2)
  netAmount         Decimal  @default(0) @db.Decimal(18, 2)
  amountInWords     String?
  approvedAt        DateTime?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  payrollRun        PayrollRun @relation(fields: [payrollRunId], references: [id], onDelete: Cascade)
  employee          Employee   @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  primaryTxn        StatementTransaction? @relation("PrimaryTxn", fields: [primaryTxnId], references: [id])
  earnings          PayrollEarningLine[]
  deductions        PayrollDeductionLine[]
  payslip           Payslip?

  @@unique([payrollRunId, employeeId])
  @@unique([primaryTxnId])
}

model PayrollEarningLine {
  id        String  @id @default(cuid())
  lineId    String
  code      String
  label     String
  actual    Decimal @db.Decimal(18, 2)
  payable   Decimal @db.Decimal(18, 2)

  line      PayrollEmployeeLine @relation(fields: [lineId], references: [id], onDelete: Cascade)
}

model PayrollDeductionLine {
  id        String  @id @default(cuid())
  lineId    String
  code      String
  label     String
  amount    Decimal @db.Decimal(18, 2)

  line      PayrollEmployeeLine @relation(fields: [lineId], references: [id], onDelete: Cascade)
}

model Payslip {
  id               String        @id @default(cuid())
  companyId        String
  employeeId       String
  payrollRunId     String
  payrollLineId    String        @unique
  status           PayslipStatus @default(DRAFT)
  verificationCode String        @unique
  currentVersion   Int           @default(0)
  issuedAt         DateTime?
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  company          Company       @relation(fields: [companyId], references: [id], onDelete: Cascade)
  employee         Employee      @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  payrollRun       PayrollRun    @relation(fields: [payrollRunId], references: [id], onDelete: Cascade)
  payrollLine      PayrollEmployeeLine @relation(fields: [payrollLineId], references: [id], onDelete: Cascade)
  versions         PayslipVersion[]
  downloads        DocumentDownloadAudit[]
  emailDeliveries  PayslipEmailDelivery[]

  @@index([companyId, employeeId])
}

model PayslipEmailDelivery {
  id            String              @id @default(cuid())
  payslipId     String
  toEmail       String
  status        EmailDeliveryStatus @default(QUEUED)
  providerMessageId String?
  failureReason String?
  resendCount   Int                 @default(0)
  queuedAt      DateTime            @default(now())
  sentAt        DateTime?
  deliveredAt   DateTime?
  failedAt      DateTime?
  createdById   String?
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt

  payslip       Payslip             @relation(fields: [payslipId], references: [id], onDelete: Cascade)

  @@index([payslipId, status])
}

model PayslipVersion {
  id                 String   @id @default(cuid())
  payslipId          String
  version            Int
  templateId         String
  pdfFileId          String?
  calcSnapshotFileId String?
  sha256             String?
  correctionReason   String?
  createdById        String?
  createdAt          DateTime @default(now())

  payslip            Payslip  @relation(fields: [payslipId], references: [id], onDelete: Cascade)
  template           CompanyTemplate @relation(fields: [templateId], references: [id])
  pdfFile            DocumentFile? @relation("PdfFile", fields: [pdfFileId], references: [id])
  calcSnapshotFile   DocumentFile? @relation("CalcSnapshot", fields: [calcSnapshotFileId], references: [id])

  @@unique([payslipId, version])
}

model DocumentDownloadAudit {
  id          String   @id @default(cuid())
  payslipId   String
  userId      String?
  ipAddress   String?
  userAgent   String?
  createdAt   DateTime @default(now())

  payslip     Payslip  @relation(fields: [payslipId], references: [id], onDelete: Cascade)
}

model TaxFinancialYearConfig {
  id          String   @id @default(cuid())
  companyId   String
  financialYear String
  regime      TaxRegime
  slabsJson   Json
  notes       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  company     Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@unique([companyId, financialYear, regime])
}

model EmployeeTaxDeclaration {
  id          String            @id @default(cuid())
  employeeId  String
  financialYear String
  regime      TaxRegime
  status      DeclarationStatus @default(DRAFT)
  itemsJson   Json
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  employee    Employee          @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@unique([employeeId, financialYear])
}

model TdsProjection {
  id            String   @id @default(cuid())
  employeeId    String
  financialYear String
  month         Int
  projectedAnnual Decimal @db.Decimal(18, 2)
  monthlyTds    Decimal @db.Decimal(18, 2)
  deductedYtd   Decimal @db.Decimal(18, 2)
  remaining     Decimal @db.Decimal(18, 2)
  assumptionsJson Json?
  createdAt     DateTime @default(now())

  employee      Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@unique([employeeId, financialYear, month])
}

model FinancialCategory {
  id          String   @id @default(cuid())
  companyId   String
  code        String
  name        String
  treatment   ProfitTreatment
  createdAt   DateTime @default(now())

  company     Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  transactions FinancialTransaction[]

  @@unique([companyId, code])
}

model FinancialTransaction {
  id          String   @id @default(cuid())
  companyId   String
  categoryId  String?
  txnDate     DateTime
  description String
  amount      Decimal  @db.Decimal(18, 2)
  isCredit    Boolean
  sourceTxnId String?
  createdAt   DateTime @default(now())

  company     Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  category    FinancialCategory? @relation(fields: [categoryId], references: [id])
}

model ProfitPolicyRule {
  id             String                      @id @default(cuid())
  companyId      String
  matchPattern   String
  classification TransactionClassification?
  treatment      ProfitTreatment
  /** Fine-grained reporting bucket (revenue, salary, CBDT, home loan, …). */
  categoryKey    String?
  label          String?
  /** Optional: credit | debit — rule applies only to that direction. */
  direction      String?
  priority       Int                         @default(100)
  isActive       Boolean                     @default(true)
  createdAt      DateTime                    @default(now())
  updatedAt      DateTime                    @updatedAt

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([companyId, priority])
}

model ProfitReportSnapshot {
  id          String   @id @default(cuid())
  companyId   String
  year        Int
  month       Int
  revenue     Decimal  @db.Decimal(18, 2)
  businessExpenses Decimal @db.Decimal(18, 2)
  earnedOperatingProfit Decimal @db.Decimal(18, 2)
  ownerFinancingOutgoings Decimal @db.Decimal(18, 2)
  cashRemaining Decimal @db.Decimal(18, 2)
  detailsJson Json?
  createdAt   DateTime @default(now())

  company     Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@unique([companyId, year, month])
}

model AuditLog {
  id          String   @id @default(cuid())
  actorUserId String?
  companyId   String?
  action      String
  entityType  String
  entityId    String?
  metadataJson Json?
  ipAddress   String?
  createdAt   DateTime @default(now())

  actor       User?    @relation("AuditActor", fields: [actorUserId], references: [id])

  @@index([companyId, createdAt])
  @@index([entityType, entityId])
  @@index([action, createdAt])
}
