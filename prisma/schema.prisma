model ClientOrganization {
  id                    String                   @id @default(cuid())
  slug                  String                   @unique
  legalName             String
  tradeName             String?
  countryCode           String
  registrationNumber    String?
  taxId                 String?
  website               String?
  billingAddressJson    Json?
  lifecycleStatus       ClientOrganizationStatus @default(DRAFT)
  intendedEmployeeCount Int?
  billingCurrency       String                   @default("GBP")
  relationshipOwnerId   String?
  proposedNovaCompanyId String?
  riskRating            String?
  createdAt             DateTime                 @default(now())
  updatedAt             DateTime                 @updatedAt

  proposedNovaCompany   Company?                 @relation("ClientProposedNova", fields: [proposedNovaCompanyId], references: [id])
  legalEntities         ClientLegalEntity[]
  memberships           ClientMembership[]
  invitations           ClientInvitation[]
  onboardingCases       ClientOnboardingCase[]
  novaAgreements        NovaEntityClientAgreement[]
  employmentAssignments EmploymentAssignment[]
  hireRequests          HireRequest[]
  pricingAgreements     ClientPricingAgreement[]
  invoices              ClientInvoice[]
  approvalTasks         ClientApprovalTask[]
  activityAudits        ClientActivityAudit[]
  sessions              Session[]
  payrollApprovals      ClientPayrollApproval[]
  fundingRequests       PayrollFundingRequest[]
  costSnapshots         EmployerCostSnapshot[]

  @@index([lifecycleStatus])
  @@index([legalName])
}

model ClientLegalEntity {
  id                   String             @id @default(cuid())
  clientOrganizationId String
  legalName            String
  countryCode          String
  registrationNumber   String?
  taxId                String?
  billingAddressJson   Json?
  isPrimaryBillTo      Boolean            @default(false)
  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt

  clientOrganization   ClientOrganization @relation(fields: [clientOrganizationId], references: [id], onDelete: Cascade)

  @@index([clientOrganizationId])
}

model ClientMembership {
  id                   String                 @id @default(cuid())
  userId               String
  clientOrganizationId String
  status               ClientMembershipStatus @default(INVITED)
  portalRole           ClientPortalRole       @default(OWNER_ADMIN)
  invitedAt            DateTime?
  acceptedAt           DateTime?
  revokedAt            DateTime?
  mfaEnrolledAt        DateTime?
  createdAt            DateTime               @default(now())
  updatedAt            DateTime               @updatedAt

  user                 User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  clientOrganization   ClientOrganization     @relation(fields: [clientOrganizationId], references: [id], onDelete: Cascade)
  permissionOverrides  ClientPermissionOverride[]
  employeeScopes       ClientEmployeeScope[]

  @@unique([userId, clientOrganizationId])
  @@index([clientOrganizationId, status])
}

model ClientPermissionOverride {
  id           String                 @id @default(cuid())
  membershipId String
  module       ClientCapabilityModule
  action       ClientCapabilityAction
  allowed      Boolean                @default(true)
  createdAt    DateTime               @default(now())

  membership   ClientMembership       @relation(fields: [membershipId], references: [id], onDelete: Cascade)

  @@unique([membershipId, module, action])
}

model ClientEmployeeScope {
  id           String           @id @default(cuid())
  membershipId String
  employeeId   String
  createdAt    DateTime         @default(now())

  membership   ClientMembership @relation(fields: [membershipId], references: [id], onDelete: Cascade)
  employee     Employee         @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@unique([membershipId, employeeId])
  @@index([employeeId])
}

model ClientInvitation {
  id                   String             @id @default(cuid())
  clientOrganizationId String
  email                String
  portalRole           ClientPortalRole   @default(HR_MANAGER)
  tokenHash            String             @unique
  expiresAt            DateTime
  acceptedAt           DateTime?
  invitedByUserId      String
  createdAt            DateTime           @default(now())

  clientOrganization   ClientOrganization @relation(fields: [clientOrganizationId], references: [id], onDelete: Cascade)
  invitedBy            User               @relation("ClientInvitationInviter", fields: [invitedByUserId], references: [id])

  @@index([clientOrganizationId, email])
}

model ClientOnboardingCase {
  id                   String             @id @default(cuid())
  clientOrganizationId String
  status               ClientOrganizationStatus
  checklistJson        Json?
  submittedAt          DateTime?
  reviewedAt           DateTime?
  reviewerNotes        String?
  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt

  clientOrganization   ClientOrganization @relation(fields: [clientOrganizationId], references: [id], onDelete: Cascade)
  kybDocuments         ClientKYBDocument[]
  complianceReviews    ClientComplianceReview[]

  @@index([clientOrganizationId])
}

model ClientKYBDocument {
  id                String             @id @default(cuid())
  onboardingCaseId  String
  category          String
  fileKey           String
  contentSha256     String
  version           Int                @default(1)
  status            String             @default("UPLOADED")
  reviewerUserId    String?
  rejectionReason   String?
  expiresAt         DateTime?
  createdAt         DateTime           @default(now())

  onboardingCase    ClientOnboardingCase @relation(fields: [onboardingCaseId], references: [id], onDelete: Cascade)

  @@index([onboardingCaseId])
}

model ClientComplianceReview {
  id               String             @id @default(cuid())
  onboardingCaseId String
  outcome          String
  riskRating       String?
  notes            String?
  reviewerUserId   String?
  createdAt        DateTime           @default(now())

  onboardingCase   ClientOnboardingCase @relation(fields: [onboardingCaseId], references: [id], onDelete: Cascade)
}

model NovaEntityClientAgreement {
  id                   String             @id @default(cuid())
  clientOrganizationId String
  novaCompanyId        String
  contractVersion      String
  effectiveFrom        DateTime
  effectiveTo          DateTime?
  approvedByUserId     String?
  createdAt            DateTime           @default(now())

  clientOrganization   ClientOrganization @relation(fields: [clientOrganizationId], references: [id], onDelete: Cascade)
  novaCompany          Company            @relation(fields: [novaCompanyId], references: [id])
  documents            AgreementDocument[]
  signatureEnvelopes   SignatureEnvelope[]

  @@index([clientOrganizationId, novaCompanyId])
}

model AgreementDocument {
  id          String                  @id @default(cuid())
  agreementId String
  docType     String
  version     String
  pdfSha256   String
  storageKey  String
  createdAt   DateTime                @default(now())

  agreement   NovaEntityClientAgreement @relation(fields: [agreementId], references: [id], onDelete: Cascade)
}

model SignatureEnvelope {
  id                   String                  @id @default(cuid())
  agreementId          String
  provider             String                  @default("manual")
  providerEnvelopeId   String?
  status               SignatureEnvelopeStatus @default(DRAFT)
  documentSha256       String
  completedAt          DateTime?
  createdAt            DateTime                @default(now())

  agreement            NovaEntityClientAgreement @relation(fields: [agreementId], references: [id], onDelete: Cascade)
  events               SignatureEvent[]
}

model SignatureEvent {
  id          String            @id @default(cuid())
  envelopeId  String
  signerName  String
  signerEmail String
  signedAt    DateTime
  evidenceJson Json?

  envelope    SignatureEnvelope @relation(fields: [envelopeId], references: [id], onDelete: Cascade)
}

model EmploymentAssignment {
  id                   String                   @id @default(cuid())
  employeeId           String
  clientOrganizationId String
  novaCompanyId        String
  status               EmploymentAssignmentStatus @default(PENDING)
  managerMembershipId  String?
  effectiveFrom        DateTime
  effectiveTo          DateTime?
  contractReference    String?
  createdAt            DateTime                 @default(now())
  updatedAt            DateTime                 @updatedAt

  employee             Employee                 @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  clientOrganization   ClientOrganization       @relation(fields: [clientOrganizationId], references: [id], onDelete: Cascade)
